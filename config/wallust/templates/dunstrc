[global]
monitor = 0
follow = keyboard
width = (350, 500)
height = (75, 225)
origin = top-right
offset = (8,0)
scale = 1
gap_size = 10
indicate_hidden = yes
frame_width = 2
corner_radius = 0
padding = 12
horizontal_padding = 12
enable_posix_regex = true
font = "Go Mono 11"
line_height = 3
alignment = left
stack_duplicates = true
hide_duplicate_count = false
icon_path = "<add-icon-path>"
min_icon_size = 12
max_icon_size = 36
markup = full
format = "<b>%a</b>\n%s\n%b"
progress_bar = true
progress_bar_height = 10
progress_bar_corner_radius = 4
progress_bar_frame_width = 1
separator_height = 2
ignore_dbusclose = false
force_xwayland = false
notification_limit = 3
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current
highlight = "{{color4 | saturate(0.5)}}"
separator_color= "{{foreground}}"

[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 2
background = "{{background | darken(0.1)}}"
foreground = "{{foreground}}"
frame_color = "{{color4}}"

[urgency_normal]
timeout = 3
background = "{{background | darken(0.1)}}"
foreground = "{{foreground}}"
frame_color = "{{color5 | saturate(0.2)}}"

[urgency_critical]
timeout = 4
background = "{{background | darken(0.1)}}"
foreground = "{{foreground}}"
frame_color = "{{color5 | saturate(1)}}"

[discord]
  appname = discord
  format = "%s\n%b"
