{

  "group/middle": {
    "orientation": "horizontal",
    "modules": [
      "image",
      "mpris",
      "ext/workspaces",
      "clock#date",
      "clock#time",
      "group/ctray"
    ]
  },

  "ext/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX"
    },
    "sort-by-id": true,
    "active-only": true,
    "on-click": "activate"
  },

  "image": {
    "exec": "~/.config/waybar/album.sh",
    "size": 22,
    "interval": 1
},

  "mpris": {
    "format": "{title} - {artist}",
    "tooltip": false,
    "title-len": 5,
    "artist-len": 5,
    "min-length": 10
  },

  "group/ctray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true,
      "click-to-reveal": true
    },

    "modules": [
      "custom/tray-wrapper",
      "tray" 
    ]
  },

  "custom/tray-wrapper": {
    "format": "+",
    "tooltip": false
  },

  "tray": {
    "spacing": 10
},

  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip": false,
    "interval": 1
  },

  "clock#date": {
    "format": "{:%a, %b %y}",
    "tooltip": false
  }
}
